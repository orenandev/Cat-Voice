# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Supabase.
# Supabase Dashboard → Project Settings → API (ou "Connect" no topo do painel).

# URL do projeto, ex: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Chave pública (publishable / anon). NUNCA use a service_role / secret key aqui.
VITE_SUPABASE_ANON_KEY=
